# Python 运行时产生的缓存
__pycache__/
*.py[cod]

# 虚拟环境（每个项目自己的依赖沙箱，绝不提交）
.venv/
venv/

# 测试与构建产物
.pytest_cache/
.tmp-tests/
*.egg-info/
build/
dist/

# 样本数据是生成出来的，不提交（生成脚本在 tools/make_sample.py）
samples/

# 开发时给界面截的图，随手产物，不进仓库
_shot_*.png

# 本地草稿与旧文档备份，不进仓库
_backup/

# 双击启动器 / exe 失败时写的日志
filetidy-gui-error.log
filetidy-error.log

# 编辑器/系统垃圾
.vscode/
.idea/
.DS_Store
Thumbs.db
